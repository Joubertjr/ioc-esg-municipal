generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Municipality {
  id          String    @id @default(cuid())
  ibgeCode    String    @unique /// 7 dígitos (ex: 4204202)
  siconfiCode String    @unique /// 6 dígitos sem verificador (ex: 420420)
  name        String
  state       String    @default("SC")
  population  Int?
  fpmAnnual   Decimal?  @db.Decimal(15, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  indicators  OdsIndicator[]
  odsScores   OdsScore[]
  simulations Simulation[]

  @@index([state])
  @@index([deletedAt])
  @@index([name])
}

model OdsIndicator {
  id             String   @id @default(cuid())
  municipalityId String
  odsNumber      Int /// 1-17
  indicatorName  String
  value          Decimal? @db.Decimal(12, 4)
  score          Int? /// 0-100, null = sem dados
  status         String? /// verde|amarelo|vermelho
  source         String
  referenceYear  Int
  referenceDate  DateTime
  dataAvailable  Boolean  @default(true)
  createdAt      DateTime @default(now())

  municipality Municipality @relation(fields: [municipalityId], references: [id])

  @@unique([municipalityId, indicatorName, referenceYear])
  @@index([municipalityId, odsNumber])
  @@index([municipalityId, referenceYear])
  @@index([referenceDate])
}

model OdsScore {
  id             String   @id @default(cuid())
  municipalityId String
  odsNumber      Int /// 1-17 (0 = global)
  score          Int? /// 0-100, null = sem dados
  geometricScore Int? /// 0-100, média geométrica ponderada (padrão IDHM/ONU)
  status         String? /// verde|amarelo|vermelho
  indicatorCount Int      @default(0)
  referenceYear  Int
  calculatedAt   DateTime @default(now())
  sources        String[] /// ex: ["ibge","siconfi"]

  municipality Municipality @relation(fields: [municipalityId], references: [id])

  @@unique([municipalityId, odsNumber, referenceYear])
  @@index([municipalityId, referenceYear])
  @@index([municipalityId, calculatedAt])
  @@index([odsNumber])
}

model Simulation {
  id               String    @id @default(cuid())
  municipalityId   String
  scenarioName     String
  investmentAmount Decimal   @db.Decimal(15, 2)
  investmentType   String /// education|health|sanitation|security|environment
  targetOds        Int[]
  projectedImpact  Json
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  municipality Municipality @relation(fields: [municipalityId], references: [id])

  @@index([municipalityId])
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  passwordHash   String
  role           String /// admin|prefeito|secretario|viewer
  municipalityId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  refreshTokens  RefreshToken[]

  @@index([municipalityId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

/// Entity no Knowledge Graph ESG. Pode representar ODS, Município, Indicador, Fonte, Política, etc.
model Entity {
  id         String   @id @default(cuid())
  /// Discriminador: "ods" | "municipality" | "indicator" | "source" | "policy" | "investment" | "benchmark" | "recommendation" | "goal"
  type       String
  /// Identificador externo estável (ex: "1" para ODS 1, código IBGE para município). Opcional.
  externalId String?
  /// Propriedades livres (nome, shortName, weight, etc)
  props      Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  outEdges Relationship[] @relation("EntityFrom")
  inEdges  Relationship[] @relation("EntityTo")

  @@unique([type, externalId])
  @@index([type])
}

/// Aresta direcionada entre dois Entity. Suporta TKG (validFrom/validUntil).
model Relationship {
  id         String    @id @default(cuid())
  /// "SINERGIA" | "TRADE_OFF" | "SIMILAR_A" | "MEDIDO_POR" | "COMPOE" | "COLETADO_DE" | "PERTENCE_A" | "IMPACTA" | "EXECUTA" | "REFERENCIA" | "ESTABELECE"
  type       String
  fromId     String
  toId       String
  /// Peso normalizado -1.0 a +1.0 (sinergia positiva, trade-off negativo), confidence 0-1, source, notes
  props      Json      @default("{}")
  /// Temporal validity (TKG / Zep Graphiti)
  validFrom  DateTime
  validUntil DateTime?
  createdAt  DateTime  @default(now())

  from Entity @relation("EntityFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Entity @relation("EntityTo",   fields: [toId],   references: [id], onDelete: Cascade)

  @@index([type, fromId])
  @@index([type, toId])
  @@index([fromId, toId])
  @@index([validFrom, validUntil])
}
