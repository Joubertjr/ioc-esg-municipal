# =============================================================================
# IOC ESG Municipal — variáveis de ambiente (desenvolvimento)
# Copie para .env e ajuste os valores.
# NUNCA commite o .env — apenas este .env.example.
#
# DOCKER-COMPOSE vs APP DIRETO:
#   - Se rodar com `docker compose up`: use host=postgres/redis (nomes dos containers)
#     Exemplo: DATABASE_URL=postgresql://ioc:ioc_secret@postgres:5432/ioc_esg?schema=public
#   - Se rodar localmente com `pnpm dev`: use host=localhost (valores abaixo)
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
# Ambiente de execução: development | test | production
NODE_ENV=development
# Porta em que o backend Express escuta
PORT=3000

# ── Banco de dados ────────────────────────────────────────────────────────────
# URL de conexão Prisma — deve começar com postgresql://
# Localmente (pnpm dev): host=localhost, porta=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ioc_esg_municipal
# Credenciais individuais usadas pelo docker-compose.yml para configurar o PostgreSQL
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ioc_esg_municipal

# ── Auth ──────────────────────────────────────────────────────────────────────
# Segredo para assinar tokens JWT — em produção: openssl rand -hex 32
JWT_SECRET=troque-por-chave-segura-em-producao
# Tempo de expiração do token (ex: 1d, 8h, 30m)
JWT_EXPIRATION=1d

# ── Redis ─────────────────────────────────────────────────────────────────────
# URL de conexão com Redis
# Localmente (pnpm dev): host=localhost, porta=6379
REDIS_URL=redis://localhost:6379
# Senha do Redis — obrigatório em produção (mín. 8 caracteres)
# Deixe vazio em desenvolvimento para rodar sem autenticação
REDIS_PASSWORD=

# ── CORS — separar múltiplas origens por vírgula ─────────────────────────────
# Origens permitidas pelo backend (sem barra final)
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL base da API consumida pelo frontend React
# Localmente (pnpm dev): aponta para o backend local
VITE_API_URL=http://localhost:3000/api

# ── APIs governamentais (todas públicas, sem chave de API) ───────────────────
# IBGE — dados demográficos (população, renda, desemprego)
IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1
# SICONFI — FPM e finanças municipais (Tesouro Nacional)
SICONFI_API_URL=https://api.siconfi.tesouro.gov.br/v1
# DATASUS — saúde e mortalidade (costuma ser instável — veja AGENT_TIMEOUT)
DATASUS_API_URL=https://datasus.saude.gov.br
# INPE / TerraBrasilis — florestal e desmatamento
INPE_API_URL=https://terrabrasilis.dpi.inpe.br/api/v1
# PNCP — licitações em tempo real (Portal Nacional de Contratações Públicas)
PNCP_API_URL=https://pncp.gov.br/api/pncp/v1

# ── Agentes (coletores de dados governamentais) ───────────────────────────────
# Timeout por requisição em ms — DATASUS é instável, mantenha >= 30000
AGENT_TIMEOUT=30000
# Número de tentativas em caso de falha (backoff exponencial: 1s, 2s, 4s)
AGENT_RETRY_COUNT=3
# Delay inicial entre tentativas em ms
AGENT_RETRY_DELAY=1000

# ── Logging ───────────────────────────────────────────────────────────────────
# Nível de log: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ── Camada agêntica MDO ───────────────────────────────────────────────────────
# Habilita respostas LLM no POST /api/agent/query (fallback determinístico se falhar)
AGENT_LLM_QA_ENABLED=false
# Chaves para LLM (opcional — só necessário se AGENT_LLM_QA_ENABLED=true)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Prefixo do carimbo institucional em relatórios publicados (HITL)
INSTITUTION_STAMP_PREFIX=Prefeitura Municipal
# Modelos LLM por tarefa (opcional — defaults no código)
# LLM_MODEL_QA=claude-haiku-4-5-20251001
# LLM_MODEL_REPORT=claude-sonnet-4-20250514

# ── Seed ──────────────────────────────────────────────────────────────────────
# Define como "true" apenas quando quiser executar o seed no entrypoint Docker.
# Em restarts normais deixe vazio ou omita — o seed não rodará automaticamente.
# Alternativa: pnpm db:seed  (fora do container)
RUN_SEED=
