# =============================================================================
# IOC ESG Municipal — variáveis de ambiente
# Copie para .env e ajuste os valores.
# NUNCA commite o .env — apenas este .env.example.
#
# DOCKER-COMPOSE vs APP DIRETO:
#   - Se rodar com `docker compose up`: use host=postgres/redis (nomes dos containers)
#     Exemplo: DATABASE_URL=postgresql://ioc:ioc_secret@postgres:5432/ioc_esg?schema=public
#   - Se rodar localmente com `pnpm dev`: use host=localhost (valores abaixo)
# =============================================================================

# ── Banco de dados ────────────────────────────────────────────────────────────
# Localmente (pnpm dev): host=localhost, porta=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ioc_esg_municipal
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=ioc_esg_municipal

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── CORS — separar múltiplas origens por vírgula ─────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Localmente (pnpm dev): aponta para o backend local
VITE_API_URL=http://localhost:3000/api

# ── Auth ──────────────────────────────────────────────────────────────────────
# Em produção: use um segredo aleatório de 32+ caracteres (ex: openssl rand -hex 32)
JWT_SECRET=troque-por-chave-segura-em-producao
JWT_EXPIRATION=1d

# ── Redis ─────────────────────────────────────────────────────────────────────
# Localmente (pnpm dev): host=localhost, porta=6379
REDIS_URL=redis://localhost:6379
# Em produção é obrigatório (mínimo 8 caracteres) — deixe vazio em desenvolvimento para rodar sem autenticação
REDIS_PASSWORD=

# ── APIs governamentais (todas públicas, sem chave de API) ───────────────────
IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1
SICONFI_API_URL=https://api.siconfi.tesouro.gov.br/v1
DATASUS_API_URL=https://datasus.saude.gov.br
INPE_API_URL=https://terrabrasilis.dpi.inpe.br/api/v1
PNCP_API_URL=https://pncp.gov.br/api/pncp/v1

# ── Agentes (coletores de dados) ──────────────────────────────────────────────
AGENT_TIMEOUT=30000
AGENT_RETRY_COUNT=3
AGENT_RETRY_DELAY=1000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
