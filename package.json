{
  "name": "ioc-esg-municipal",
  "version": "0.1.0",
  "description": "Intelligent Operations Center para ESG em Municípios Brasileiros",
  "main": "dist/backend/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "tsx watch backend/index.ts",
    "dev:frontend": "cd frontend && vite",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:backend": "tsc",
    "build:frontend": "cd frontend && vite build",
    "start": "node dist/backend/index.js",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest tests/",
    "eval:memory": "tsx scripts/run-longmemeval.ts",
    "eval:agent": "tsx evals/agent-esg/run.ts",
    "eval:agent:fast": "tsx evals/agent-esg/run.ts -- --skip-integration",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed:kg": "tsx scripts/seed-knowledge-graph.ts",
    "db:studio": "prisma studio",
    "docker:up": "docker compose up -d",
    "docker:up:infra": "docker compose up -d postgres redis",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "madge:circular": "madge --circular --extensions ts backend/",
    "madge:orphans": "madge --orphans --extensions ts backend/",
    "madge:graph": "madge --extensions ts --image /tmp/ioc-dep-graph.svg backend/",
    "data:update:snis": "tsx scripts/update-snis-data.ts",
    "data:update:inep": "tsx scripts/update-inep-data.ts",
    "data:update:sisvan": "tsx scripts/update-sisvan-data.ts",
    "data:update:anatel": "tsx scripts/update-anatel-data.ts",
    "data:update:aneel": "tsx scripts/update-aneel-data.ts",
    "data:update:convenios": "tsx scripts/update-convenios-data.ts",
    "data:update:ieps": "tsx scripts/update-ieps-data.ts",
    "data:update:transferegov": "tsx scripts/update-transferegov-data.ts",
    "data:update:all": "pnpm data:update:snis && pnpm data:update:inep && pnpm data:update:sisvan && pnpm data:update:anatel && pnpm data:update:aneel && pnpm data:update:convenios && pnpm data:update:ieps && pnpm data:update:transferegov",
    "smoke:final": "bash scripts/smoke-final.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.0.1",
    "@prisma/client": "^5.7.1",
    "@types/compression": "^1.8.1",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "prisma": "^5.7.1",
    "prom-client": "^15.1.3",
    "redis": "^4.6.12",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "@vitest/ui": "^1.1.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch@>=9.0.0 <9.0.7": "9.0.9",
      "lodash@<=4.17.23": "4.18.1"
    }
  },
  "prisma": {
    "seed": "node dist/prisma/seed.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "author": "IOC ESG Team",
  "license": "MIT"
}
