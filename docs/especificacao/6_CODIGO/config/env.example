# IOC ESG MUNICIPAL - VARIÁVEIS DE AMBIENTE

# ===== BANCO DE DADOS =====
DATABASE_URL=postgresql://user:password@localhost:5432/ioc_esg_municipal
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=ioc_esg_municipal
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ===== SERVIDOR =====
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ===== FRONTEND =====
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=IOC ESG Municipal

# ===== AUTENTICAÇÃO =====
JWT_SECRET=sua_chave_secreta_aqui
JWT_EXPIRATION=7d

# ===== APIS EXTERNAS =====
# IBGE
IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1

# Tesouro Nacional
TESOURO_API_URL=https://siconfi.tesouro.gov.br/api
TESOURO_API_KEY=sua_chave_aqui

# DATASUS
DATASUS_API_URL=https://datasus.saude.gov.br/api

# INEP
INEP_API_URL=https://www.gov.br/inep/pt-br/

# SNIS
SNIS_API_URL=https://www.snis.gov.br/api

# INPE
INPE_API_URL=http://www.inpe.gov.br/api

# PNCP
PNCP_API_URL=https://www.comprasgovernamentais.gov.br/api

# TCE-SC
TCE_SC_API_URL=http://www.tcesc.tc.br/api

# ===== LOGGING =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== CACHE =====
REDIS_URL=redis://localhost:6379
CACHE_TTL=3600

# ===== AGENTES =====
AGENT_TIMEOUT=30000
AGENT_RETRY_COUNT=3
AGENT_RETRY_DELAY=1000

# ===== SIMULAÇÃO =====
SIMULATION_ENGINE=mirofish
SIMULATION_TIMEOUT=60000

# ===== EMAIL =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha
SMTP_FROM=noreply@ioc-esg.com.br

# ===== STORAGE =====
STORAGE_TYPE=local
STORAGE_PATH=./uploads
# Ou para S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=sua_chave
# AWS_SECRET_ACCESS_KEY=sua_secreta
# AWS_BUCKET=ioc-esg-bucket
# AWS_REGION=us-east-1

# ===== SEGURANÇA =====
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===== MONITORAMENTO =====
SENTRY_DSN=
DATADOG_API_KEY=

# ===== DESENVOLVIMENTO =====
DEBUG=false
MOCK_DATA=false
