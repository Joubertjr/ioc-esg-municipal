{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@backend/*": ["./backend/*"],
      "@frontend/*": ["./frontend/*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["backend/**/*", "shared/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "dist", "frontend"]
}
