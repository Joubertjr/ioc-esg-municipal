# =============================================================================
# IOC ESG Municipal — variáveis de ambiente PRODUÇÃO
# =============================================================================
# Copie para .env no servidor de produção e preencha TODOS os valores.
# NUNCA commite este arquivo com valores reais.
# Gere segredos com: openssl rand -hex 32
#
# Deploy:
#   IMAGE_TAG=<commit-sha> docker compose -f docker-compose.prod.yml up -d
# =============================================================================

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Porta interna do container (o docker-compose.prod.yml expõe apenas em 127.0.0.1)
PORT=3000

# ── Imagem Docker ─────────────────────────────────────────────────────────────
# Registry da imagem — ex: ghcr.io/seu-org
REGISTRY=ghcr.io/seu-org
# Tag do deploy — use o commit SHA para rastreabilidade (ex: abc1234)
IMAGE_TAG=latest

# ── Banco de dados ────────────────────────────────────────────────────────────
# URL de conexão Prisma — host é o nome do serviço Docker (postgres)
# NUNCA use senhas fracas em produção
DATABASE_URL=postgresql://ioc_prod:SENHA_FORTE_AQUI@postgres:5432/ioc_esg_prod?schema=public
# Credenciais individuais para configurar o container PostgreSQL
DATABASE_USER=ioc_prod
DATABASE_PASSWORD=SENHA_FORTE_AQUI
DATABASE_NAME=ioc_esg_prod

# ── Auth ──────────────────────────────────────────────────────────────────────
# Obrigatório: mínimo 32 caracteres aleatórios
# Gere com: openssl rand -hex 32
JWT_SECRET=GERE_COM_OPENSSL_RAND_HEX_32
# Tempo de expiração do token (ex: 1d, 8h, 30m)
JWT_EXPIRATION=1d

# ── Redis ─────────────────────────────────────────────────────────────────────
# URL de conexão — host é o nome do serviço Docker (redis); inclua a senha no URL
REDIS_URL=redis://:REDIS_SENHA_FORTE@redis:6379
# Obrigatório em produção — mínimo 8 caracteres (recomendado: 16+)
# Gere com: openssl rand -hex 16
REDIS_PASSWORD=GERE_COM_OPENSSL_RAND_HEX_16

# ── CORS ──────────────────────────────────────────────────────────────────────
# Domínio(s) do frontend em produção — sem barra final, sem localhost
# Múltiplos separados por vírgula: https://app.seudominio.com.br,https://admin.seudominio.com.br
ALLOWED_ORIGINS=https://app.seudominio.com.br

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# URL pública da API consumida pelo frontend React em produção
VITE_API_URL=https://api.seudominio.com.br/api

# ── APIs governamentais (todas públicas, sem chave de API) ───────────────────
# IBGE — dados demográficos (população, renda, desemprego)
IBGE_API_URL=https://servicodados.ibge.gov.br/api/v1
# SICONFI — FPM e finanças municipais (Tesouro Nacional)
SICONFI_API_URL=https://api.siconfi.tesouro.gov.br/v1
# DATASUS — saúde e mortalidade (costuma ser instável — veja AGENT_TIMEOUT)
DATASUS_API_URL=https://datasus.saude.gov.br
# INPE / TerraBrasilis — florestal e desmatamento
INPE_API_URL=https://terrabrasilis.dpi.inpe.br/api/v1
# PNCP — licitações em tempo real (Portal Nacional de Contratações Públicas)
PNCP_API_URL=https://pncp.gov.br/api/pncp/v1

# ── Agentes (coletores de dados governamentais) ───────────────────────────────
# Timeout por requisição em ms — DATASUS é instável, mantenha >= 30000
AGENT_TIMEOUT=30000
# Número de tentativas em caso de falha (backoff exponencial: 1s, 2s, 4s)
AGENT_RETRY_COUNT=3
# Delay inicial entre tentativas em ms
AGENT_RETRY_DELAY=1000

# ── Logging ───────────────────────────────────────────────────────────────────
# Em produção: info ou warn (evite debug — gera volume excessivo)
# Opções: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ── Monitoramento (Grafana) ──────────────────────────────────────────────────
# Senha do admin do Grafana — mude imediatamente após deploy
GRAFANA_PASSWORD=GERE_COM_OPENSSL_RAND_HEX_16
